NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Agentes de IA (servidor). Configure ao menos uma chave; a ordem define a reserva automática.
NVIDIA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER_ORDER=nvidia,gemini,groq
# Opcional: trocar modelos sem mexer no código
NVIDIA_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b
# Esforço de raciocínio dos modelos (low = mais rápido). Deixe vazio para modelos sem raciocínio.
AI_REASONING_EFFORT=low
# Modelo da NVIDIA usado pelo agente Gerente (relatórios)
GERENTE_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Segredo da rota pedResumo do Apps Script (mesmo valor de resumo_segredo, 24+ caracteres)
PEDIDOS_RESUMO_SEGREDO=
